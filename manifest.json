{
  "manifest_version": 3,
  "name": "电商图片提取下载",
  "version": "1.0.0",
  "description": "从淘宝、京东、拼多多商家版商品详情页一键提取并下载商品图片（PNG）",
  "permissions": [
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.tmall.hk/*",
    "*://*.jd.com/*",
    "*://*.jd.hk/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",
    "*://*.alicdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.jdcdn.com/*",
    "*://*.360buyimg.com/*",
    "*://*.pddpic.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://item.taobao.com/*",
        "*://detail.tmall.com/*",
        "*://detail.tmall.hk/*",
        "*://chaoshi.detail.tmall.com/*",
        "*://item.jd.com/*",
        "*://item.m.jd.com/*",
        "*://npcitem.jd.hk/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*",
        "*://mms.pinduoduo.com/*",
        "*://*.jinritemai.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "电商图片提取下载",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/viewer.html", "viewer/viewer.css", "viewer/viewer.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
